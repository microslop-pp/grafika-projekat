# Simple 1x1x1 cube centered at origin, for use as a light debug marker
mtllib light_cube.mtl
o light_cube
usemtl white

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 1.0 0.0

# back (-z)
f 1/1/1 2/2/1 3/3/1
f 3/3/1 4/4/1 1/1/1
# front (+z)
f 5/1/2 8/4/2 7/3/2
f 7/3/2 6/2/2 5/1/2
# left (-x)
f 1/1/3 4/4/3 8/3/3
f 8/3/3 5/2/3 1/1/3
# right (+x)
f 2/1/4 6/2/4 7/3/4
f 7/3/4 3/4/4 2/1/4
# bottom (-y)
f 1/1/5 5/2/5 6/3/5
f 6/3/5 2/4/5 1/1/5
# top (+y)
f 4/1/6 3/2/6 7/3/6
f 7/3/6 8/4/6 4/1/6
